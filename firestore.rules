rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles & roles (Traveler, Captain, Vehicle Owner, Transport Company)
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated() ? isOwner(userId) : true;
      allow delete: if isAuthenticated() && isOwner(userId);
    }

    // Vehicle Registry (Captain / Owner multi-vehicle garage)
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || !('ownerId' in resource.data));
    }

    // Intercity Trips & Vehicle Listings (Public search + Captain ownership)
    match /intercityListings/{listingId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated() ? (
        !('driverUid' in resource.data) || 
        resource.data.driverUid == request.auth.uid || 
        resource.data.ownerUid == request.auth.uid
      ) : true;
    }

    // Live Bookings & Passenger Tickets
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Planned Trips & Itineraries (Tracking code / Family access)
    match /trips/{tripId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Real-Time Live Notifications & Broadcasts
    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAuthenticated();
    }

    // Highway Road Status & Mountain Pass Alerts
    match /roadAlerts/{alertId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAuthenticated();
    }
  }
}

